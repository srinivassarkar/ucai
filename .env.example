# ucai Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit your actual .env file to version control.

# --- Compute Node (Inference Server) ---
# The SSH user and IP/hostname of the machine running llama-server (e.g. over Tailscale)
UCAI_COMPUTE_HOST="user@100.x.y.z"
UCAI_COMPUTE_PORT="8080"
UCAI_URL="http://100.x.y.z:8080"

# Path to the llama-server startup script on the compute node
UCAI_LLAMA_SCRIPT="$HOME/models/llama.sh"

# Model configuration paths on the compute node
UCAI_MODEL_DIR="$HOME/models"
UCAI_MODEL_PATH="$UCAI_MODEL_DIR/Qwen3.8-27B.gguf"
UCAI_MMPROJ_PATH="$UCAI_MODEL_DIR/mmproj-model-bf16.gguf"
UCAI_MCP_CONFIG="$UCAI_MODEL_DIR/mcp.json"
UCAI_UI_CONFIG="$UCAI_MODEL_DIR/webui_config.json"

# --- Sandbox Node (Tool Execution Sandbox) ---
# The SSH user and IP/hostname of the isolated secondary machine running mcp_ucai.py
UCAI_SANDBOX_HOST="sandbox_user@100.a.b.c"

# Path to the private SSH key on the compute node used to access the sandbox node
UCAI_SANDBOX_KEY="$HOME/.ssh/ucai_sandbox"

# Root sandbox directory and python interpreter on the sandbox node
UCAI_SANDBOX_DIR="$HOME/agent_sandbox"
UCAI_SANDBOX_PYTHON="/usr/bin/python3"
